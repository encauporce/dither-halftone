//!HOOK MAIN
//!DESC Hisense A7 E-ink Video Enhancer (Adaptive Halftone + Spatio-Temporal Dither + Anti-Ghosting)
//!BIND HOOKED
//!WIDTH HOOKED.w
//!HEIGHT HOOKED.h

/**
 * ============================================================================
 * 海信 A7 墨水屏核心视频着色器 (Hisense A7 E-ink Video Shader)
 * ----------------------------------------------------------------------------
 * 核心针对痛点：
 * 1. 【暗部残影】暗色调视频大量死黑导致微胶囊粒子滞留粘滞，极难清除。
 *    解决：动态黑电平抬升(Dark Lift) + 时域高频微跳动(FRC Phase Inversion)强制震荡微胶囊。
 * 2. 【色阶断层】原版单依靠抖动导致极速模式下仅 2~4 阶灰阶，等高线严重。
 *    解决：利用 300 PPI 高解析度冗余，平坦区启用 3x3 空间网点(Halftoning)
 *          + 空间蓝噪(IGN) + 2 帧时域微相移，平滑扩展至 60~90 级感知连续色阶；
 *          高频边缘自适应旁路切回 1x1，保留文字与轮廓的原生单像素极高锐度。
 * ============================================================================
 */

// --------------------------- [用户可调控核心参数] ---------------------------
// 1. 暗部防残影控制
#define DARK_LIFT_MIN       0.09    // 纯黑抬升底电平 (0.06 ~ 0.14)，彻底消除永久死黑滞留
#define DARK_LIFT_CURVE     0.78    // 暗部伽马曲线指数 (<1.0 展开暗部动态范围)
#define TEMPORAL_DARK_BOOST 1.6     // 暗部时域震荡增强系数 (强化微胶囊脱困微脉冲)

// 2. 空间网点 (Halftoning) 控制
#define K_HALFTONE          1.0     // 平坦区网点强度 (1.0 = 标准 3x3 印刷网点基底)

// 3. 空域高频抖动 (Spatial Dithering)
#define A_SPATIAL           0.95    // 空间蓝噪填充振幅 (抚平网点阶梯分界线)

// 4. 时域交替抖动 (Temporal FRC)
#define A_TEMPORAL          0.70    // 时域两帧交替振幅 (提升 1 倍感知色阶并打散残影)

// 5. 边缘自适应保护阈值
#define EDGE_MIN            0.035   // Sobel 梯度下限 (低于此值视为平滑区，全开网点)
#define EDGE_MAX            0.180   // Sobel 梯度上限 (高于此值视为边缘区，切回 300 PPI 锐利原图)

// --------------------------- [辅助数学函数] ---------------------------------

// Interleaved Gradient Noise (IGN)
// 极度轻量且具备蓝噪(Blue Noise)高频分布特性的无序哈希，两行指令，无纹理依赖
float ign_dither(vec2 p) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(p, magic.xy)));
}

// 3x3 聚类网点（AM 调幅网点矩阵，取值范围归一化至 [-0.5, 0.5]）
// 矩阵索引布局：
//   7  2  6
//   4  0  1
//   8  3  5
float halftone3x3(vec2 p) {
    ivec2 ip = ivec2(mod(p, 3.0));
    float m[9] = float[9](
        7.0, 2.0, 6.0,
        4.0, 0.0, 1.0,
        8.0, 3.0, 5.0
    );
    return (m[ip.y * 3 + ip.x] / 8.0) - 0.5;
}

// --------------------------- [着色器主入口] ---------------------------------

vec4 hook() {
    vec2 pixel_coord = HOOKED_pos * HOOKED_size;

    // 1. 获取中心像素色彩与感知亮度 (ITU-R BT.709)
    vec4 src_color = HOOKED_tex(HOOKED_pos);
    float luma = dot(src_color.rgb, vec3(0.2126, 0.7152, 0.0722));

    // 2. 8 邻域 Sobel 空间梯度检测（感知局部空间频率与边缘）
    float l00 = dot(HOOKED_texOff(vec2(-1.0, -1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l10 = dot(HOOKED_texOff(vec2( 0.0, -1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l20 = dot(HOOKED_texOff(vec2( 1.0, -1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l01 = dot(HOOKED_texOff(vec2(-1.0,  0.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l21 = dot(HOOKED_texOff(vec2( 1.0,  0.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l02 = dot(HOOKED_texOff(vec2(-1.0,  1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l12 = dot(HOOKED_texOff(vec2( 0.0,  1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));
    float l22 = dot(HOOKED_texOff(vec2( 1.0,  1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));

    float gx = (l20 + 2.0 * l21 + l22) - (l00 + 2.0 * l01 + l02);
    float gy = (l02 + 2.0 * l12 + l22) - (l00 + 2.0 * l10 + l20);
    float grad = sqrt(gx * gx + gy * gy);

    // 边缘平滑权重：0.0 = 平滑平坦区，1.0 = 高频边缘线
    float w_edge = smoothstep(EDGE_MIN, EDGE_MAX, grad);
    float w_half = (1.0 - w_edge) * K_HALFTONE;

    // 3. 【防残影关键一】动态暗部黑电平抬升 (Black Level Lift & Tone Remap)
    // 将 [0.0, 1.0] 映射至 [DARK_LIFT_MIN, 1.0]，避免大面积像素长时间沉在物理绝对死黑
    float luma_lifted = DARK_LIFT_MIN + (1.0 - DARK_LIFT_MIN) * pow(luma, DARK_LIFT_CURVE);

    // 4. 【空间网点】3x3 空间宏观超像素网点分量 (构建 28 阶基底)
    float step_half = 1.0 / 28.0;
    float halftone_offset = halftone3x3(pixel_coord) * step_half * w_half;

    // 5. 【空域抖动】IGN 蓝噪高频微抖动（平滑网点台阶缝隙）
    float noise_val = ign_dither(pixel_coord) - 0.5;
    float spatial_dither_offset = noise_val * step_half * A_SPATIAL;

    // 6. 【时域抖动 & 防残影关键二】奇偶帧微相位交替震荡 (FRC)
    // 棋盘格奇偶空间分布 + 帧时序推进
    float f_mod = mod(float(frame), 2.0);
    float spatial_checker = mod(floor(pixel_coord.x) + floor(pixel_coord.y), 2.0);
    float temporal_phase = (f_mod == spatial_checker) ? 0.5 : -0.5;

    // 暗部强化：暗区粒子最容易滞留，加大微扰动幅度；极亮白色区域自然衰减防止人眼视觉频闪
    float dark_boost = 1.0 + TEMPORAL_DARK_BOOST * (1.0 - luma_lifted);
    float bright_taper = smoothstep(0.96, 0.72, luma_lifted);
    float temporal_dither_offset = temporal_phase * (step_half * 0.5) * A_TEMPORAL * dark_boost * bright_taper;

    // 7. 连续能量场无缝叠加与输出
    float final_luma = clamp(luma_lifted + halftone_offset + spatial_dither_offset + temporal_dither_offset, 0.0, 1.0);

    return vec4(vec3(final_luma), src_color.a);
}
